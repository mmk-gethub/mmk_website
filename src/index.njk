---
layout: base.njk
---

<!-- Hero Section -->
    <section id="home" class="hero">
        <div class="floating floating-1">🪔</div>
        <div class="floating floating-2">🎭</div>
        <div class="floating floating-3">🧧</div>
        <div class="hero-content">
            <h1>
                Maharashtra Mandal Krakow
                <span class="marathi">महाराष्ट्र मंडळ क्रॅको</span>
            </h1>
            <p>Celebrating and preserving the rich Marathi culture, traditions, and heritage in the heart of Poland.
                Join us in our cultural journey.</p>
            <div class="hero-buttons">
                <a href="/events/2026/march/gudi-padwa-2026/" class="btn btn-primary">Upcoming Event</a>
                <a href="#about" class="btn btn-secondary">About Us</a>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about">
        <div class="section-header">
            <h2>About <span>Us</span></h2>
            <p>We are a vibrant community of Marathi-speaking people in Krakow, dedicated to preserving our cultural
                roots while embracing our new home.</p>
        </div>
        <div class="about-grid">
            <div class="about-card fade-in">
                <i class="fas fa-hand-holding-heart"></i>
                <h3>Cultural Preservation</h3>
                <p>Celebrating Maharashtra's rich heritage through traditional festivals like Ganeshotsav, Diwali, Gudi
                    Padwa, and more.</p>
            </div>
            <div class="about-card fade-in">
                <i class="fas fa-users"></i>
                <h3>Community Building</h3>
                <p>Creating a warm and welcoming space for Marathi families and individuals to connect, share, and grow
                    together.</p>
            </div>
            <div class="about-card fade-in">
                <i class="fas fa-globe-europe"></i>
                <h3>Cultural Exchange</h3>
                <p>Bridging the gap between Indian and Polish cultures through interactive events and collaborations.
                </p>
            </div>
            <div class="about-card fade-in">
                <i class="fas fa-calendar-alt"></i>
                <h3>Regular Events</h3>
                <p>Organizing monthly cultural gatherings, food festivals, dance workshops, and celebration of Indian
                    festivals.</p>
            </div>
        </div>
    </section>

    <!-- Events Section -->
    <section id="events" class="events">
        <div class="section-header">
            <h2>Upcoming <span>Events</span></h2>
            <p>Mark your calendars for our upcoming cultural celebrations and gatherings.</p>
        </div>
        <div class="events-timeline">
            <div class="event-item fade-in">
                <div class="event-card">
                    <span class="event-date">March 2026</span>
                    <h3>Gudi Padwa (गुढीपाडवा)</h3>
                    <p>Step into the festive spirit of Gudhi Padwa where our community gathers to welcome new beginnings with vibrant traditions, cultural performances
                    and the timeless warmth of Maharashtra.</p>
                    <div class="event-location">
                              <i class="fas fa-map-marker-alt"></i>
                                    Krakow, Poland
                     </div>
                    <div class="event-action">
                        <a href="/events/2026/march/gudi-padwa-2026/" class="btn btn-primary">View Details</a>
                    </div>
                </div>
            </div>
            <div class="event-item fade-in">
                <div class="event-card">
                    <span class="event-date">Feb 2026</span>
                    <h3>Shivjayanti</h3>
                    <p>On Shiv Jayanti, our community gathers to celebrate the inspiring legacy of Chhatrapati Shivaji Maharaj through culture, stories and a shared sense of pride.</p>
                    <div class="event-location">
                              <i class="fas fa-map-marker-alt"></i>
                                Krakow, Poland
                    </div>
                    <div class="event-action">
                        <a href="/events/2026/february/shivjayanti-2026/" class="btn btn-primary">View Details</a>
                    </div>
                </div>
            </div>
            <div class="event-item fade-in">
                <div class="event-card">
                    <span class="event-date">Jan 2026</span>
                    <h3>Makar-Sankranti</h3>
                    <p>First celebration of the year! Celebrated Makar Sankranti with aranging Haldi-Kunku get together followed by games!</p>
                     <div class="event-location">
                                            <i class="fas fa-map-marker-alt"></i>
                                            Krakow, Poland
                             </div>
                    <div class="event-action">
                        <a href="/events/2026/january/makar-sankranti-2026/" class="btn btn-primary">View Details</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="view-all-events">
            <a href="/events/" class="btn btn-primary">View All Events</a>
        </div>
    </section>

    <!-- Gallery Section -->
    <section id="gallery" class="gallery">
        <div class="section-header">
            <h2>Photo <span>Gallery</span></h2>
            <p>Relive the beautiful moments from our past events and celebrations.</p>
        </div>
        <div class="gallery-tabs">
            <button class="gallery-tab active" data-tab="photos">Photos</button>
            <button class="gallery-tab" data-tab="videos">Videos</button>
        </div>
        <div id="photos" class="gallery-content active">
            <div class="gallery-grid">
                {% for image in collections.galleryImages %}
                <div class="gallery-item {% if loop.index > 8 %}hidden-gallery-item{% endif %}" onclick="openLightbox(this)">
                    <img src="{{ image.url }}" alt="{{ image.alt }}">
                    <i class="fas fa-expand"></i>
                </div>
                {% else %}
                <p>No recent photos available yet.</p>
                {% endfor %}
            </div>
        </div>
        <div id="videos" class="gallery-content">
            <div class="video-grid">
                <div class="video-item">
                    <iframe src="https://www.youtube.com/embed/nwxu4S-BLck?start=170" title="YouTube video"
                        allowfullscreen></iframe>
                </div>
                <div class="video-item">
                    <iframe src="https://www.youtube.com/embed/nwxu4S-BLck?start=170" title="YouTube video"
                        allowfullscreen></iframe>
                </div>
                <div class="video-item">
                    <iframe src="https://www.youtube.com/embed/nwxu4S-BLck?start=170" title="YouTube video"
                        allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </section>

    <!-- Blog Section -->
    <section id="blog" class="blog">
        <div class="section-header">
            <h2>Community <span>Updates</span></h2>
            <p>Stay connected with poems, stories, and creativity from the MMK family.</p>
        </div>
        <div class="blog-grid">
            
        {% for post in collections.post | reverse %}
          {% if loop.index <= 3 %}
            <article class="blog-card fade-in">
                <img src="{{ post.data.image | replace('../', '') }}" alt="{{ post.data.title }}" class="blog-image">
                <div class="blog-content">
                    <span class="blog-date">{{ post.data.date | formatDate }}</span>
                    {% if post.data.author %}
                    <span style="font-size: 0.85rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.5rem; display: block;"><i class="fas fa-user-circle" style="color: var(--primary);"></i> {{ post.data.author }}</span>
                    {% endif %}
                    <h3>{{ post.data.title }}</h3>
                    <p>{{ post.data.excerpt }}</p>
                    <a href="{{ post.url }}" class="blog-link">Read More <i class="fas fa-arrow-right"></i></a>
                </div>
            </article>
          {% endif %}
        {% endfor %}

        </div>
        <div class="view-all-events">
            <a href="/community_updates/" class="btn btn-secondary">View All Posts</a>
        </div>
    </section>

    <!-- Sponsors Section -->
    <section id="sponsors" class="sponsors">
        <div class="section-header">
            <h2>Our <span>Sponsors</span></h2>
            <p>Partners who support our community initiatives and cultural events.</p>
        </div>
        <div class="sponsors-carousel">
            <div class="sponsors-track">
                <a href="https://indiabazaar.pl/" target="_blank" class="sponsor-card"><img src="images/sponsors/India_bazaar.png" alt="India Bazaar"></a>
                <a href="https://malayali.rocks/" target="_blank" class="sponsor-card"><img src="images/sponsors/malayali_3.png" alt="Malayali 3"></a>
                <a href="https://ib-polska.pl/centrum-wielokulturowe-w-krakowie/" target="_blank" class="sponsor-card"><img src="images/sponsors/centrum_wielokulturowe.png" alt="Centrum Wielokulturowe"></a>
                <a href="https://cosmo.edu.pl/schools/krakow/" target="_blank" class="sponsor-card"><img src="images/sponsors/cosmopoliton_school.png" alt="Cosmopolitan School"></a>
                <a href="https://ib-polska.pl/" target="_blank" class="sponsor-card"><img src="images/sponsors/foundation_ib_polska.png" alt="Foundation IB Polska"></a>
                <div class="sponsor-card"><img src="images/sponsors/lemonn_india.png" alt="Lemonn India"></div>
                <a href="https://www.littleindia.pl/lang/en" target="_blank" class="sponsor-card"><img src="images/sponsors/little_india.png" alt="Little India"></a>
                <a href="https://malayali.rocks/" target="_blank" class="sponsor-card"><img src="images/sponsors/malayali_1.png" alt="Malayali 1"></a>
                <a href="https://malayali.rocks/" target="_blank" class="sponsor-card"><img src="images/sponsors/malayali_2.png" alt="Malayali 2"></a>
                <a href="https://www.optionsellingmarathi.com/" target="_blank" class="sponsor-card"><img src="images/sponsors/marathi_option_selling.png" alt="Marathi Option Selling"></a>
                <a href="https://www.shubhmangaleurope.com/" target="_blank" class="sponsor-card"><img src="images/sponsors/shubhmangal_europe.png" alt="Shubhmangal Europe"></a>
                <!-- Duplicated for infinite scroll effect below -->
                <a href="https://indiabazaar.pl/" target="_blank" class="sponsor-card" aria-hidden="true"><img src="images/sponsors/India_bazaar.png" alt="India Bazaar"></a>
                <a href="https://malayali.rocks/" target="_blank" class="sponsor-card" aria-hidden="true"><img src="images/sponsors/malayali_3.png" alt="Malayali 3"></a>
                <a href="https://ib-polska.pl/centrum-wielokulturowe-w-krakowie/" target="_blank" class="sponsor-card" aria-hidden="true"><img src="images/sponsors/centrum_wielokulturowe.png" alt="Centrum Wielokulturowe"></a>
                <a href="https://cosmo.edu.pl/schools/krakow/" target="_blank" class="sponsor-card" aria-hidden="true"><img src="images/sponsors/cosmopoliton_school.png" alt="Cosmopolitan School"></a>
                <a href="https://ib-polska.pl/" target="_blank" class="sponsor-card" aria-hidden="true"><img src="images/sponsors/foundation_ib_polska.png" alt="Foundation IB Polska"></a>
                <div class="sponsor-card" aria-hidden="true"><img src="images/sponsors/lemonn_india.png" alt="Lemonn India"></div>
                <a href="https://www.littleindia.pl/lang/en" target="_blank" class="sponsor-card" aria-hidden="true"><img src="images/sponsors/little_india.png" alt="Little India"></a>
                <a href="https://malayali.rocks/" target="_blank" class="sponsor-card" aria-hidden="true"><img src="images/sponsors/malayali_1.png" alt="Malayali 1"></a>
                <a href="https://malayali.rocks/" target="_blank" class="sponsor-card" aria-hidden="true"><img src="images/sponsors/malayali_2.png" alt="Malayali 2"></a>
                <a href="https://www.optionsellingmarathi.com/" target="_blank" class="sponsor-card" aria-hidden="true"><img src="images/sponsors/marathi_option_selling.png" alt="Marathi Option Selling"></a>
                <a href="https://www.shubhmangaleurope.com/" target="_blank" class="sponsor-card" aria-hidden="true"><img src="images/sponsors/shubhmangal_europe.png" alt="Shubhmangal Europe"></a>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact">
        <div class="section-header">
            <h2>Get in <span>Touch</span></h2>
            <p>We'd love to hear from you. Reach out to learn more about our community and events.</p>
        </div>
        <div class="contact-grid">
            <div class="contact-info">
                <h3>Contact Information</h3>
                <div class="contact-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <div>
                        <h4>Location</h4>
                        <p>Krakow, Poland</p>
                    </div>
                </div>
                <div class="contact-item">
                    <i class="fas fa-envelope"></i>
                    <div>
                        <h4>Email</h4>
                        <p>maharashtramandalkrakow@gmail.com</p>
                    </div>
                </div>
                <div class="contact-item">
                    <i class="fas fa-phone"></i>
                    <div>
                        <h4>Phone</h4>
                        <p>+48 729 361 136</p>
                    </div>
                </div>
                <h4 style="margin-top: 2rem;">Follow Us</h4>
                <div class="social-links">
                    <a href="https://www.facebook.com/profile.php?id=61587636773982" target="_blank" aria-label="Facebook"><i
                            class="fab fa-facebook-f"></i></a>
                    <a href="https://www.instagram.com/maharashtramandalkrakow?igsh=bDViODZlYzlmbDN2&utm_source=qr" target="_blank" aria-label="Instagram"><i
                            class="fab fa-instagram"></i></a>
                    <a href="https://youtube.com" target="_blank" aria-label="YouTube"><i
                            class="fab fa-youtube"></i></a>
                </div>
            </div>
            <form class="contact-form" name="contact" method="POST" data-netlify="true">
                <div class="form-group">
                    <label for="name">Your Name</label>
                    <input type="text" id="name" name="name" placeholder="Enter your name" required>
                </div>
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" placeholder="Enter your email" required>
                </div>
                <div class="form-group">
                    <label for="subject">Subject</label>
                    <select id="subject" name="subject">
                        <option value="">Select a subject</option>
                        <option value="general">General Inquiry</option>
                        <option value="event">Event Information</option>
                        <option value="membership">Membership</option>
                        <option value="volunteer">Volunteering</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="message">Message</label>
                    <textarea id="message" name="message" placeholder="Write your message here..." required></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Send Message</button>
            </form>
        </div>
    </section>

    
